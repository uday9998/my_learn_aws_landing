{
  "pages": {
    "/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/page.css",
      "static/chunks/app/page.js"
    ],
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ],
    "/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/not-found.css",
      "static/chunks/app/not-found.js"
    ],
    "/(authorization)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(authorization)/layout.css",
      "static/chunks/app/(authorization)/layout.js"
    ],
    "/(authorization)/login/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(authorization)/login/page.css",
      "static/chunks/app/(authorization)/login/page.js"
    ]
  }
}